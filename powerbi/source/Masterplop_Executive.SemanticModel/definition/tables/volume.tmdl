		sourceColumn: period_label

	partition volume = m
		mode: import
		source =
				let
				    EmbeddedCsv = "",
				    Source = Csv.Document(Binary.FromText(EmbeddedCsv, BinaryEncoding.Base64), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"period_year", Int64.Type}, {"period_quarter", Int64.Type}, {"quarter_start_date", type date}, {"product_type", type text}, {"active_cards", Int64.Type}, {"transaction_count", Int64.Type}}, "en-US"),
				    WithPeriod = Table.AddColumn(Typed, "period_label", each Text.From([period_year]) & " T" & Text.From([period_quarter]), type text)
				in
				    WithPeriod

	annotation PBI_ResultType = Table
