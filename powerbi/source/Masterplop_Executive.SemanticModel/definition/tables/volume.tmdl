		summarizeBy: sum
		sourceColumn: period_year

	column period_quarter
		dataType: int64
		formatString: #,0
		lineageTag: e75a435b-c32a-4803-a8b0-195f644445e4
		summarizeBy: sum
		sourceColumn: period_quarter

	column quarter_start_date
		dataType: dateTime
		formatString: dd-MM-yyyy
