	partition regional_ticket = m
		mode: import
		source =
				let
				    EmbeddedCsv = "",
				    Source = Csv.Document(Binary.FromText(EmbeddedCsv, BinaryEncoding.Base64), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"issuer_country", type text}, {"product_name", type text}, {"transaction_count", Int64.Type}, {"net_spend_usd", Currency.Type}, {"avg_transaction_amount_usd", Currency.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
