	partition executive = m
		mode: import
		source =
				let
				    EmbeddedCsv = "",
				    Source = Csv.Document(Binary.FromText(EmbeddedCsv, BinaryEncoding.Base64), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"active_cards", Int64.Type}, {"transaction_count", Int64.Type}, {"total_net_spend_usd", Currency.Type}, {"avg_transaction_amount_usd", Currency.Type}, {"total_cashback_usd", Currency.Type}, {"beneficiary_card_count", Int64.Type}, {"min_transaction_date", type date}, {"max_transaction_date", type date}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
