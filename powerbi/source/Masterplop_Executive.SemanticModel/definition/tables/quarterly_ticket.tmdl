		lineageTag: beb1d572-b262-48e8-9f87-981d04f08e96
		summarizeBy: none
		sourceColumn: period_label

	partition quarterly_ticket = m
		mode: import
		source =
				let
				    EmbeddedCsv = "77u/cGVyaW9kX3llYXIscGVyaW9kX3F1YXJ0ZXIscXVhcnRlcl9zdGFydF9kYXRlLG5ldF9zcGVuZF91c2QsYWN0aXZlX2NyZWRpdF9jYXJkcyxuZXRfc3BlbmRfcGVyX2FjdGl2ZV9jYXJkX3VzZA0KMjAyNCwxLDIwMjQtMDEtMDEsMTUwOTY0OTI3LjEwLDQ2NzQ3LDMyMjkuNDANCjIwMjQsMiwyMDI0LTA0LTAxLDI1NjE3NDAwNC4yMCw1MTAzNyw1MDE5LjM4DQo=",
				    Source = Csv.Document(Binary.FromText(EmbeddedCsv, BinaryEncoding.Base64), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"period_year", Int64.Type}, {"period_quarter", Int64.Type}, {"quarter_start_date", type date}, {"net_spend_usd", Currency.Type}, {"active_credit_cards", Int64.Type}, {"net_spend_per_active_card_usd", Currency.Type}}, "en-US"),
				    WithPeriod = Table.AddColumn(Typed, "period_label", each Text.From([period_year]) & " T" & Text.From([period_quarter]), type text)
				in
				    WithPeriod

	annotation PBI_ResultType = Table
