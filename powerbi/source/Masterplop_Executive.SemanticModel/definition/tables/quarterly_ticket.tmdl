		formatString: #,0
		lineageTag: 44a4a3af-3947-420d-b494-88034891dc1c
		summarizeBy: sum
		sourceColumn: period_year

	column period_quarter
		dataType: int64
		formatString: #,0
		lineageTag: 764ecd0a-66fb-495a-b0b9-115f59492f34
		summarizeBy: sum
		sourceColumn: period_quarter

	column quarter_start_date
		dataType: dateTime
		formatString: dd-MM-yyyy
